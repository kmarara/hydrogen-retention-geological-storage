{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Week 10: PINN Integration - Safety Penalty Layer for Tactical Analysis\n",
        "\n",
        "> **Milestone:** Integrate PINN output as GIS safety penalty layer for candidate sites\n",
        "> **Deliverable:** Notebook 07 complete - PINN safety penalty integrated with strategic screening layer\n",
        "\n",
        "*From PROJECT_BRIEF.md - Phase 3: PINN Integration (Weeks 9-11)*"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import matplotlib\nmatplotlib.use('Agg')\n",
        "import matplotlib.pyplot as plt\n",
        "import os\n",
        "import json\n",
        "from shapely.geometry import box\n",
        "import geopandas as gpd\n",
        "\n",
        "wd = '/home/recursivex/my_projects/my_career/2026_roadmap_fully_funded_opportunities/hydrogen_storage_site_selection'\n",
        "os.chdir(wd)\n",
        "\n",
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "print(f'Using device: {device}')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Load Strategic Screening Results (Week 8)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Load case study results\n",
        "with open('outputs/southern_africa_case_study.json', 'r') as f:\n",
        "    case_study = json.load(f)\n",
        "\n",
        "roi_bounds = case_study['roi_bounds']\n",
        "candidate_regions = case_study['candidate_regions']\n",
        "roi = box(*roi_bounds)\n",
        "roi_gdf = gpd.GeoDataFrame({'geometry': [roi]}, crs='EPSG:4326')\n",
        "\n",
        "print(f'ROI bounds: {roi_bounds}')\n",
        "print(f'Candidate regions: {len(candidate_regions)}')\n",
        "for r in candidate_regions:\n",
        "    print(f'  Region {r[\"id\"]}: ({r[\"center_lat\"]:.3f}, {r[\"center_lon\"]:.3f}), size={r[\"size_pixels\"]} px, score={r[\"mean_score\"]:.3f}, robust={r[\"robust_fraction\"]:.2f}')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Load PINN Model (Week 9-10)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# PINN Architecture (same as training)\n",
        "class PINNIFTS(nn.Module):\n",
        "    def __init__(self, input_dim=3, hidden_dim=64, output_dim=1, n_hidden_layers=4):\n",
        "        super(PINNIFTS, self).__init__()\n",
        "        self.net = nn.Sequential(\n",
        "            nn.Linear(input_dim, hidden_dim), nn.Tanh(),\n",
        "            nn.Linear(hidden_dim, hidden_dim), nn.Tanh(),\n",
        "            nn.Linear(hidden_dim, hidden_dim), nn.Tanh(),\n",
        "            nn.Linear(hidden_dim, hidden_dim), nn.Tanh(),\n",
        "            nn.Linear(hidden_dim, output_dim)\n",
        "        )\n",
        "        self.log_Tc = nn.Parameter(torch.log(torch.tensor(33.2)))\n",
        "        self.log_Pc = nn.Parameter(torch.log(torch.tensor(1.30)))\n",
        "        self.omega = nn.Parameter(torch.tensor(-0.216))\n",
        "    \n",
        "    @property\n",
        "    def Tc(self): return torch.exp(self.log_Tc)\n",
        "    @property\n",
        "    def Pc(self): return torch.exp(self.log_Pc)\n",
        "    \n",
        "    def forward(self, x):\n",
        "        return self.net(x)\n",
        "\n",
        "# Load trained model\n",
        "model = PINNIFTS()\n",
        "checkpoint = torch.load('outputs/pinn_ift_model_pr_eos.pt', map_location=device)\n",
        "model.load_state_dict(checkpoint['model_state_dict'])\n",
        "model.to(device)\n",
        "model.eval()\n",
        "\n",
        "print(f'Loaded PINN with PR-EOS')\n",
        "print(f'Learned Tc: {checkpoint[\"learned_Tc\"]:.1f} K (lit: 33.2 K)')\n",
        "print(f'Learned Pc: {checkpoint[\"learned_Pc\"]:.2f} MPa (lit: 1.30 MPa)')\n",
        "print(f'Learned ω: {checkpoint[\"learned_omega\"]:.4f} (lit: -0.216)')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Define Reservoir Conditions for Candidate Regions\n",
        "\n",
        "For each candidate region, estimate reservoir conditions (P, T, Salinity) based on depth and geology.\n",
        "Southern Africa basins: Kalahari, Orange, Zululand, etc."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Estimated reservoir conditions for each candidate region\n",
        "# Based on typical Southern Africa basin depths and geothermal gradients\n",
        "reservoir_conditions = {\n",
        "    272: {'name': 'Region 272 (Kalahari Basin)', 'depth_km': 2.5, 'P_MPa': 25, 'T_K': 360, 'Sal_ppm': 50000},\n",
        "    69:  {'name': 'Region 69 (Orange Basin)',  'depth_km': 3.0, 'P_MPa': 30, 'T_K': 380, 'Sal_ppm': 80000},\n",
        "    413: {'name': 'Region 413 (Zululand)',    'depth_km': 2.0, 'P_MPa': 20, 'T_K': 340, 'Sal_ppm': 120000},\n",
        "    65:  {'name': 'Region 65 (Namib)',        'depth_km': 1.8, 'P_MPa': 18, 'T_K': 330, 'Sal_ppm': 150000},\n",
        "    95:  {'name': 'Region 95 (Etosha)',       'depth_km': 2.2, 'P_MPa': 22, 'T_K': 350, 'Sal_ppm': 60000},\n",
        "}\n",
        "\n",
        "# Predict IFT for each region\n",
        "ift_predictions = {}\n",
        "for region_id, cond in reservoir_conditions.items():\n",
        "    X = torch.tensor([[cond['P_MPa'], cond['T_K'], cond['Sal_ppm']]], dtype=torch.float32).to(device)\n",
        "    with torch.no_grad():\n",
        "        IFT = model(X).item()\n",
        "    ift_predictions[region_id] = {\n",
        "        'IFT_mN_m': IFT,\n",
        "        'conditions': cond\n",
        "    }\n",
        "    print(f'{cond[\"name\"]}: P={cond[\"P_MPa\"]} MPa, T={cond[\"T_K\"]} K, Sal={cond[\"Sal_ppm\"]} ppm -> IFT = {IFT:.2f} mN/m')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Safety Penalty Calculation\n",
        "\n",
        "High IFT -> higher capillary trapping risk -> lower safety score\n",
        "Safety penalty = normalized IFT (higher IFT = higher penalty = lower suitability)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Compute safety penalty from IFT\n",
        "# IFT range in predictions: typically 10-40 mN/m for reservoir conditions\n",
        "# Normalize to [0, 1] where 1 = highest penalty (worst safety)\n",
        "\n",
        "ift_values = [v['IFT_mN_m'] for v in ift_predictions.values()]\n",
        "ift_min, ift_max = min(ift_values), max(ift_values)\n",
        "\n",
        "print(f'IFT range across regions: {ift_min:.2f} - {ift_max:.2f} mN/m')\n",
        "\n",
        "for region_id, pred in ift_predictions.items():\n",
        "    IFT = pred['IFT_mN_m']\n",
        "    # Safety penalty: higher IFT = higher penalty\n",
        "    penalty = (IFT - ift_min) / (ift_max - ift_min) if ift_max > ift_min else 0.5\n",
        "    # Safety score: inverse of penalty\n",
        "    safety_score = 1 - penalty\n",
        "    \n",
        "    ift_predictions[region_id]['safety_penalty'] = penalty\n",
        "    ift_predictions[region_id]['safety_score'] = safety_score\n",
        "    \n",
        "    print(f'Region {region_id}: IFT={IFT:.2f} mN/m, Safety Penalty={penalty:.3f}, Safety Score={safety_score:.3f}')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Integrate with Strategic Screening Scores\n",
        "\n",
        "Combine strategic suitability (from Week 8) with tactical safety penalty:\n",
        "Final Score = w_strategic * Strategic_Score + w_safety * Safety_Score"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Load strategic scores for candidate regions\n",
        "strategic_scores = {r['id']: r['mean_score'] for r in candidate_regions}\n",
        "\n",
        "# Weight for combining strategic and tactical layers\n",
        "w_strategic = 0.7  # Regional screening weight\n",
        "w_safety = 0.3     # Physics-based safety weight\n",
        "\n",
        "integrated_results = {}\n",
        "for region_id in strategic_scores:\n",
        "    strategic = strategic_scores[region_id]\n",
        "    safety = ift_predictions[region_id]['safety_score']\n",
        "    integrated = w_strategic * strategic + w_safety * safety\n",
        "    \n",
        "    integrated_results[region_id] = {\n",
        "        'strategic_score': strategic,\n",
        "        'safety_score': safety,\n",
        "        'integrated_score': integrated,\n",
        "        'IFT_mN_m': ift_predictions[region_id]['IFT_mN_m'],\n",
        "        'conditions': ift_predictions[region_id]['conditions']\n",
        "    }\n",
        "    \n",
        "    print(f'Region {region_id}: Strategic={strategic:.3f}, Safety={safety:.3f}, Integrated={integrated:.3f}')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Uncertainty Quantification\n",
        "\n",
        "Monte Carlo dropout for PINN prediction intervals"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Monte Carlo dropout for uncertainty estimation\n",
        "def mc_dropout_predict(model, X, n_samples=100):\n",
        "    model.train()  # Enable dropout\n",
        "    preds = []\n",
        "    for _ in range(n_samples):\n",
        "        with torch.no_grad():\n",
        "            pred = model(X).item()\n",
        "            preds.append(pred)\n",
        "    model.eval()\n",
        "    return np.mean(preds), np.std(preds)\n",
        "\n",
        "# Add dropout to model for uncertainty\n",
        "class PINNWithDropout(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.net = nn.Sequential(\n",
        "            nn.Linear(3, 64), nn.Tanh(), nn.Dropout(0.1),\n",
        "            nn.Linear(64, 64), nn.Tanh(), nn.Dropout(0.1),\n",
        "            nn.Linear(64, 64), nn.Tanh(), nn.Dropout(0.1),\n",
        "            nn.Linear(64, 64), nn.Tanh(), nn.Dropout(0.1),\n",
        "            nn.Linear(64, 1)\n",
        "        )\n",
        "        self.log_Tc = nn.Parameter(torch.log(torch.tensor(33.2)))\n",
        "        self.log_Pc = nn.Parameter(torch.log(torch.tensor(1.30)))\n",
        "        self.omega = nn.Parameter(torch.tensor(-0.216))\n",
        "    @property\n",
        "    def Tc(self): return torch.exp(self.log_Tc)\n",
        "    @property\n",
        "    def Pc(self): return torch.exp(self.log_Pc)\n",
        "    def forward(self, x): return self.net(x)\n",
        "\n",
        "# Create dropout model and copy weights\n",
        "model_dropout = PINNWithDropout()\n",
        "# Copy weights from trained model (skip dropout layers)\n",
        "trained_state = checkpoint['model_state_dict']\n",
        "dropout_state = model_dropout.state_dict()\n",
        "for k in trained_state:\n",
        "    if k in dropout_state and trained_state[k].shape == dropout_state[k].shape:\n",
        "        dropout_state[k] = trained_state[k]\n",
        "model_dropout.load_state_dict(dropout_state)\n",
        "model_dropout.to(device)\n",
        "\n",
        "# Predict with uncertainty\n",
        "print('\\nUncertainty quantification (MC Dropout, 100 samples):')\n",
        "for region_id, pred in ift_predictions.items():\n",
        "    cond = pred['conditions']\n",
        "    X = torch.tensor([[cond['P_MPa'], cond['T_K'], cond['Sal_ppm']]], dtype=torch.float32).to(device)\n",
        "    mean_ift, std_ift = mc_dropout_predict(model_dropout, X, n_samples=100)\n",
        "    \n        "    ift_predictions[region_id]['ift_mean'] = mean_ift\n",
        "    ift_predictions[region_id]['ift_std'] = std_ift\n",
        "    ift_predictions[region_id]['ift_ci_95'] = 1.96 * std_ift\n",
        "    \n",
        "    print(f'Region {region_id}: IFT = {mean_ift:.2f} ± {1.96*std_ift:.2f} mN/m (95% CI)')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Visualization: Tactical Analysis Results"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Create tactical analysis visualization\n",
        "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
        "\n",
        "# 1. IFT predictions per region\n",
        "regions = list(ift_predictions.keys())\n",
        "names = [reservoir_conditions[r]['name'] for r in regions]\n",
        "ifts = [ift_predictions[r]['IFT_mN_m'] for r in regions]\n",
        "safety = [ift_predictions[r]['safety_score'] for r in regions]\n",
        "integrated = [integrated_results[r]['integrated_score'] for r in regions]\n",
        "\n",
        "colors = plt.cm.RdYlGn(np.linspace(0.2, 0.8, len(regions)))\n",
        "bars = axes[0,0].barh(range(len(regions)), ifts, color=colors, edgecolor='black')\n",
        "axes[0,0].set_yticks(range(len(regions)))\n",
        "axes[0,0].set_yticklabels([f'R{r}' for r in regions])\n",
        "axes[0,0].set_xlabel('IFT (mN/m)')\n",
        "axes[0,0].set_title('H2-Brine IFT Prediction per Candidate Region')\n",
        "for i, (bar, val) in enumerate(zip(bars, ifts)):\n",
        "    axes[0,0].text(bar.get_width() + 0.5, bar.get_y() + bar.get_height()/2, f'{val:.1f}', va='center')\n",
        "\n",
        "# 2. Safety Score vs Strategic Score\n",
        "strat = [strategic_scores[r] for r in regions]\n",
        "axes[0,1].scatter(strat, safety, c=colors, s=100, edgecolor='black', zorder=5)\n",
        "for i, r in enumerate(regions):\n",
        "    axes[0,1].annotate(f'R{r}', (strat[i], safety[i]), xytext=(5,5), textcoords='offset points')\n",
        "axes[0,1].set_xlabel('Strategic Suitability Score')\n",
        "axes[0,1].set_ylabel('Safety Score (1 - Penalty)')\n",
        "axes[0,1].set_title('Strategic vs Tactical Safety')\n",
        "axes[0,1].grid(True, alpha=0.3)\n",
        "\n",
        "# 3. Integrated Score Ranking\n",
        "sorted_regions = sorted(regions, key=lambda r: integrated_results[r]['integrated_score'], reverse=True)\n",
        "int_scores = [integrated_results[r]['integrated_score'] for r in sorted_regions]\n",
        "bars = axes[1,0].barh(range(len(sorted_regions)), int_scores, color=colors[::-1], edgecolor='black')\n",
        "axes[1,0].set_yticks(range(len(sorted_regions)))\n",
        "axes[1,0].set_yticklabels([f'R{r}' for r in sorted_regions])\n",
        "axes[1,0].set_xlabel('Integrated Score (0.7×Strategic + 0.3×Safety)')\n",
        "axes[1,0].set_title('Final Site Ranking (Go/No-Go Decision)')\n",
        "for i, (bar, val) in enumerate(zip(bars, int_scores)):\n",
        "    axes[1,0].text(bar.get_width() + 0.01, bar.get_y() + bar.get_height()/2, f'{val:.3f}', va='center')\n",
        "\n",
        "# 4. Uncertainty intervals\n",
        "means = [ift_predictions[r]['ift_mean'] for r in sorted_regions]\n",
        "cis = [ift_predictions[r]['ift_ci_95'] for r in sorted_regions]\n",
        "axes[1,1].errorbar(means, range(len(sorted_regions)), xerr=cis, fmt='o', capsize=5, markersize=8)\n",
        "axes[1,1].set_yticks(range(len(sorted_regions)))\n",
        "axes[1,1].set_yticklabels([f'R{r}' for r in sorted_regions])\n",
        "axes[1,1].set_xlabel('IFT (mN/m)')\n",
        "axes[1,1].set_title('IFT Prediction with 95% CI (MC Dropout)')\n",
        "axes[1,1].grid(True, alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig('outputs/tactical_analysis_results.png', dpi=150, bbox_inches='tight')\n",
        "plt.close()\n",
        "\n",
        "print('Tactical analysis visualization saved!')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Final Go/No-Go Recommendations\n",
        "\n",
        "Decision criteria:\n",
        "- GO: Integrated score >= 0.65 AND safety score >= 0.5\n",
        "- CONDITIONAL GO: Integrated score >= 0.55\n",
        "- NO-GO: Below thresholds"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Final decision for each region\n",
        "print('\\n=== FINAL GO/NO-GO RECOMMENDATIONS ===')\n",
        "for r in sorted_regions:\n",
        "    res = integrated_results[r]\n",
        "    strat = res['strategic_score']\n",
        "    safety = res['safety_score']\n",
        "    integ = res['integrated_score']\n",
        "    IFT = res['IFT_mN_m']\n",
        "    ci = ift_predictions[r]['ift_ci_95']\n",
        "    \n",
        "    if integ >= 0.65 and safety >= 0.5:\n",
        "        decision = '✅ GO'\n",
        "    elif integ >= 0.55:\n",
        "        decision = '⚠️ CONDITIONAL GO'\n",
        "    else:\n",
        "        decision = '❌ NO-GO'\n",
        "    \n",
        "    print(f'\\nRegion {r} ({reservoir_conditions[r][\"name\"]}):')\n",
        "    print(f'  Reservoir: P={res[\"conditions\"][\"P_MPa\"]} MPa, T={res[\"conditions\"][\"T_K\"]} K, Sal={res[\"conditions\"][\"Sal_ppm\"]} ppm')\n",
        "    print(f'  IFT Prediction: {IFT:.2f} ± {ci:.2f} mN/m')\n",
        "    print(f'  Strategic Score: {strat:.3f}')\n",
        "    print(f'  Safety Score: {safety:.3f}')\n",
        "    print(f'  Integrated Score: {integ:.3f}')\n",
        "    print(f'  Decision: {decision}')\n",
        "    \n",
        "    integrated_results[r]['decision'] = decision\n",
        "    integrated_results[r]['ift_ci_95'] = ci"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Export Tactical Layer Results"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Save tactical analysis results\n",
        "tactical_results = {\n",
        "    'model_info': {\n",
        "        'architecture': 'PINN 4-layer Tanh + PR-EOS physics',\n",
        "        'learned_Tc_K': checkpoint['learned_Tc'],\n",
        "        'learned_Pc_MPa': checkpoint['learned_Pc'],\n",
        "        'learned_omega': checkpoint['learned_omega']\n",
        "    },\n",
        "    'reservoir_conditions': reservoir_conditions,\n",
        "    'ift_predictions': {str(k): v for k, v in ift_predictions.items()},\n",
        "    'integrated_scores': {str(k): v for k, v in integrated_results.items()},\n",
        "    'weights': {'strategic': w_strategic, 'safety': w_safety},\n",
        "    'decision_thresholds': {'go': 0.65, 'conditional_go': 0.55, 'safety_min': 0.5}\n",
        "}\n",
        "\n",
        "with open('outputs/tactical_analysis_results.json', 'w') as f:\n",
        "    json.dump(tactical_results, f, indent=2)\n",
        "\n",
        "print('\\nTactical analysis results exported to outputs/tactical_analysis_results.json')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Week 10 Deliverables Summary\n",
        "\n",
        "- **PINN with PR-EOS physics loss:** outputs/pinn_ift_model_pr_eos.pt\n",
        "- **Tactical safety penalty layer:** IFT predictions for 5 candidate regions\n",
        "- **Integrated site ranking:** Combined strategic + tactical scores\n",
        "- **Uncertainty quantification:** MC Dropout 95% CI on IFT predictions\n",
        "- **Final decisions:** GO/Conditional GO/NO-GO for each candidate region\n",
        "- **Visualization:** outputs/tactical_analysis_results.png\n",
        "- **Export:** outputs/tactical_analysis_results.json for Phase 3 completion\n",
        "\n",
        "---\n",
        "*Next: Week 11 - Final integration and paper draft (Week 12)*"
      ]
    }
  ],
